
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/shop/shops",
      "destination": "/api/legacy/shop/shops"
    },
    {
      "source": "/me",
      "destination": "/api/legacy/me"
    },
    {
      "source": "/logout",
      "destination": "/api/legacy/logout"
    },
    {
      "source": "/shop/:path*",
      "destination": "/api/legacy/shop/:path*"
    },
    {
      "source": "/client/bookings",
      "destination": "/api/legacy/client/bookings"
    },
    {
      "source": "/client/stats",
      "destination": "/api/legacy/client/stats"
    },
    {
      "source": "/appointment/:path*",
      "destination": "/api/legacy/appointment/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/legacy/auth/:path*"
    },
    {
      "source": "/availability/:path*",
      "destination": "/api/legacy/availability/:path*"
    },
    {
      "source": "/shops/:path*",
      "destination": "/api/legacy/shops/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/legacy/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
    
  ]
}
