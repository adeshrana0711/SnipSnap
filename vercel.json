{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/me",
      "destination": "/api/api.js"
    },
    {
      "source": "/logout",
      "destination": "/api/api.js"
    },
    {
      "source": "/shop/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/shop/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/client/login",
      "destination": "/index.html"
    },
    {
      "source": "/client/registration",
      "destination": "/index.html"
    },
    {
      "source": "/client/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/appointment/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/availability/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/shops/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/api.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
