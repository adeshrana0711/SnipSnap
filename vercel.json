{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/me",
      "destination": "/api/me"
    },
    {
      "source": "/logout",
      "destination": "/api/logout"
    },
    {
      "source": "/shop/profile",
      "destination": "/api/shop/profile"
    },
    {
      "source": "/client/bookings",
      "destination": "/api/client/bookings"
    },
    {
      "source": "/client/stats",
      "destination": "/api/client/stats"
    },
    {
      "source": "/appointment/:path*",
      "destination": "/api/appointment/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/availability/:path*",
      "destination": "/api/availability/:path*"
    },
    {
      "source": "/shops/:path*",
      "destination": "/api/shops/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads/:path*"
    }
  ]
}